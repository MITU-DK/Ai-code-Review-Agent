#  AI Code Review Agent — Environment Variables
#  Copy this file to .env and fill in values
#  NEVER commit the actual .env file to GitHub!

# GitHub Settings
# Generate a Personal Access Token at:
# https://github.com/settings/tokens
# Required scopes: repo (full), pull_requests
GITHUB_TOKEN=your_github_personal_access_token_here

# GitHub Webhook Secret
# You will set this string yourself when registering
# the webhook in your GitHub repo settings.
# It can be any random string (e.g., use: openssl rand -hex 32)
WEBHOOK_SECRET=my_super_secure_secret_123123

# Groq API Key
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# LLM Model (via Groq)
# Recommended options:
#   - llama-3.3-70b-versatile  (most capable — RECOMMENDED)
#   - llama-3.1-8b-instant     (fast, good for testing)
#   - mixtral-8x7b-32768       (great for code tasks)
GROQ_MODEL=llama-3.3-70b-versatile
